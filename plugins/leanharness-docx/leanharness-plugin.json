{
  "id": "leanharness-docx",
  "name": "LeanHarness DOCX",
  "version": "0.1.0",
  "description": "Generate a structured DOCX document as a controlled workspace artifact.",
  "protocol_version": "leanharness.plugin.v1",
  "entrypoint": ["python", "plugin.py"],
  "tools": [
    {
      "name": "docx_generate",
      "description": "Generate a DOCX document at a workspace-relative output_path. Supply structured sections containing paragraphs, ordered or unordered lists, code blocks, or simple tables. The file is created by an isolated plugin process and written to the workspace by LeanHarness core.",
      "mutation": true,
      "artifact_extension": ".docx",
      "artifact_media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "parameters": {
        "type": "object",
        "properties": {
          "output_path": {"type": "string", "description": "Workspace-relative .docx path."},
          "title": {"type": "string", "description": "Document title."},
          "author": {"type": "string", "description": "Optional author metadata."},
          "subject": {"type": "string", "description": "Optional subject metadata."},
          "header": {"type": "string", "description": "Optional page header."},
          "footer": {"type": "string", "description": "Optional page footer."},
          "sections": {
            "type": "array",
            "description": "Ordered document sections.",
            "items": {
              "type": "object",
              "properties": {
                "heading": {"type": "string"},
                "level": {"type": "integer", "minimum": 1, "maximum": 6},
                "blocks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {"type": "string", "enum": ["paragraph", "ordered_list", "unordered_list", "code", "table"]},
                      "text": {"type": "string"},
                      "items": {"type": "array", "items": {"type": "string"}},
                      "language": {"type": "string"},
                      "headers": {"type": "array", "items": {"type": "string"}},
                      "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}
                    },
                    "required": ["type"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["heading", "blocks"],
              "additionalProperties": false
            }
          }
        },
        "required": ["output_path", "title", "sections"],
        "additionalProperties": false
      }
    }
  ]
}
